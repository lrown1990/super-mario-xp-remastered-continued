// One of Bowser's hammers (Enemy_14 of level 64, ev. 330/331): thrown from
// the raised arm at 240 px/s, steeply upwards, and brought down by the
// engine's gravity, which for the objects that engine shoots was MEASURED on
// the video on Mario's own hammers: 0.145 px/frame^2 at 50 fps = 362 px/s^2
// (six clean throws between 0.143 and 0.149). The frames are the original's
// spinning hammer, 193-200, the same images Mario's hammer uses.
depth = 20;
image_speed = 1;
vx = 0;
vy = 0;
GRAVITA = 362;
